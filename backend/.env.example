# --- Aplicación ---
APP_NAME=AlimentoSolidario Huancayo API
APP_DESCRIPTION=Backend académico con FastAPI para gestión de donaciones, solicitudes y entregas.
APP_VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=8000

# --- CORS ---
# Orígenes permitidos separados por comas (Angular en desarrollo).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Seguridad JWT ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SQL Server ---
# `(local)` uses local SQL Server without requiring TCP/IP or a network port.
DB_HOST=(local)
DB_PORT=1433
DB_NAME=alimento_solidario
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=5

# Para utilizar autenticación SQL en lugar de la cuenta de Windows:
# DB_TRUSTED_CONNECTION=false
# DB_USER=sa
# DB_PASSWORD=reemplazar_por_una_contraseña_segura
# To use TCP/IP instead, enable it for SQL Server and set DB_HOST=tcp:localhost.
